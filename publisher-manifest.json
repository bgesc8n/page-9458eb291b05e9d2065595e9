          "body": "<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#f4f4f4;color:#111;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\nimg,svg{display:block;max-width:100%}\n\n/* 强调色:一抹烈橙 */\n:root{--ink:#0d0d0d;--paper:#f4f4f4;--line:#1a1a1a;--muted:#6b6b6b;--soft:#e6e6e6;--accent:#ff5a1f}\n\n.wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n\n/* 顶栏 — 极细横条,只放跳转锚点 */\n.topbar{position:sticky;top:0;z-index:10;background:rgba(244,244,244,.92);backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid #d8d8d8}\n.topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:44px;font-size:13px}\n.topbar .brand{font-weight:800;letter-spacing:.5px;color:var(--ink)}\n.topbar nav{display:flex;gap:18px;flex-wrap:wrap;justify-content:flex-end}\n.topbar nav a{color:#333}\n.topbar nav a:hover{color:var(--accent)}\n\n/* HERO — 纵向时间线 */\n.hero{padding:64px 0 48px;border-bottom:1px solid #d8d8d8;background:#f4f4f4}\n.hero .wrap{display:grid;grid-template-columns:1fr;gap:36px}\n.hero h1{font-size:clamp(36px,5.4vw,72px);line-height:1.05;letter-spacing:-1px;margin:0 0 8px;font-weight:900;color:var(--ink)}\n.hero h1 .accent{color:var(--accent)}\n.hero .lede{max-width:640px;font-size:17px;color:#222;margin:0}\n.hero .meta{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-top:18px}\n\n.timeline{margin-top:36px;border-left:2px dashed #9a9a9a;padding-left:24px;display:grid;gap:18px}\n.timeline .step{position:relative}\n.timeline .step::before{content:\"\";position:absolute;left:-31px;top:8px;width:12px;height:12px;background:#f4f4f4;border:2px solid var(--ink);border-radius:50%}\n.timeline .step time{font-family:\"Courier New\",monospace;font-size:12px;color:var(--muted);letter-spacing:1px}\n.timeline .step h3{margin:4px 0 4px;font-size:18px;color:var(--ink)}\n.timeline .step p{margin:0;color:#333;font-size:14.5px}\n.timeline .step.now::before{background:var(--accent);border-color:var(--accent)}\n\n/* 区块通用 */\nsection{padding:64px 0;border-bottom:1px solid #d8d8d8}\nsection h2{font-size:clamp(24px,3vw,34px);letter-spacing:-.5px;margin:0 0 8px;color:var(--ink)}\nsection .sub{color:#333;margin:0 0 28px;max-width:680px}\nsection .kicker{font-size:12px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;margin-bottom:10px}\n\n/* 票据式卡片 — 虚线框 */\n.ticket{border:1.5px dashed #1a1a1a;background:#fff;padding:22px 22px 18px;border-radius:2px;position:relative}\n.ticket .tag{position:absolute;top:-10px;left:18px;background:var(--ink);color:#fff;font-size:11px;letter-spacing:2px;padding:3px 8px;text-transform:uppercase}\n.ticket .tag.acc{background:var(--accent)}\n.ticket h3{margin:8px 0 6px;font-size:20px;color:var(--ink)}\n.ticket ul{margin:10px 0 14px;padding-left:18px;color:#222}\n.ticket ul li{margin:6px 0;font-size:14.5px}\n.ticket .price{font-family:\"Courier New\",monospace;font-size:22px;font-weight:700;color:var(--ink)}\n.ticket .annual{font-size:12.5px;color:var(--muted);margin-top:4px}\n.ticket .stamp{position:absolute;top:14px;right:14px;border:1.5px solid var(--accent);color:var(--accent);font-size:10px;letter-spacing:2px;padding:2px 6px;transform:rotate(-6deg)}\n\n/* 套餐 — 两栏对照配推荐 */\n.plans{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.plans .col{display:grid;gap:20px}\n@media (max-width:760px){.plans{grid-template-columns:1fr}}\n\n/* 使用说明 — 编号大字压底 */\n.how{display:grid;gap:14px}\n.how .row{display:grid;grid-template-columns:64px 1fr;gap:18px;align-items:start;border-top:1px dashed #9a9a9a;padding:18px 6px}\n.how .row:last-child{border-bottom:1px dashed #9a9a9a}\n.how .num{font-family:\"Courier New\",monospace;font-size:46px;line-height:1;color:var(--accent);font-weight:700}\n.how .row h3{margin:4px 0 6px;font-size:17px;color:var(--ink)}\n.how .row p{margin:0;color:#222;font-size:14.5px}\n\n/* FAQ — 对话气泡 */\n.faq{display:grid;gap:18px;max-width:880px}\n.faq .qa{display:grid;grid-template-columns:64px 1fr;gap:14px;align-items:start}\n.faq .ava{width:44px;height:44px;border-radius:50%;background:#1a1a1a;color:#fff;display:grid;place-items:center;font-weight:700;font-size:14px;letter-spacing:1px}\n.faq .q .bubble{background:#fff;border:1.5px dashed #1a1a1a;padding:12px 14px;display:inline-block;max-width:100%}\n.faq .q .bubble .who{font-size:11px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;margin-bottom:4px}\n.faq .a .bubble{background:var(--ink);color:#fff;border:1.5px solid var(--ink);padding:12px 14px;display:inline-block;max-width:100%}\n.faq .a .bubble .who{font-size:11px;letter-spacing:2px;color:#cfcfcf;text-transform:uppercase;margin-bottom:4px}\n.faq .a{margin-top:6px;padding-left:58px}\n\n/* 节点 / 设备兼容表 — 票据列表 */\n.nodes{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n@media (max-width:760px){.nodes{grid-template-columns:1fr 1fr}}\n@media (max-width:480px){.nodes{grid-template-columns:1fr}}\n.nodes .ticket{padding:18px}\n.nodes .ticket h4{margin:6px 0 4px;font-size:16px;color:var(--ink)}\n.nodes .ticket p{margin:0;color:#333;font-size:13.5px}\n\n/* 收尾 — 单色页脚 */\n.foot{padding:36px 0;background:#0d0d0d;color:#cfcfcf;font-size:13px}\n.foot .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px}\n.foot .dot{display:inline-block;width:8px;height:8px;background:var(--accent);border-radius:50%;margin-right:8px;vertical-align:middle}\n\n/* 主区块容器 — 至少一个 main */\nmain{display:block}\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <span class=\"brand\">直连 / ZHI.LIAN</span>\n    <nav aria-label=\"区块锚点\">\n      <a href=\"#story\">节点纪事</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#how\">使用流程</a>\n      <a href=\"#nodes\">节点与设备</a>\n      <a href=\"#faq\">常见问答</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n<section class=\"hero\" id=\"story\">\n  <div class=\"wrap\">\n    <div>\n      <p class=\"kicker\">ISSUE 01 — 直连 · 节点时间线</p>\n      <h1>直连:沿一条时间线,把节点<span class=\"accent\">串成</span>你的日常。</h1>\n      <p class=\"lede\">下面的时间线,记录了直连从一台测试服务器到多区域节点池的演进过程。每一格代表一次线路扩容或一次协议更新,它们共同构成了今天你看到的“直连”。</p>\n      <p class=\"meta\">更新时间:每月 1 日 · 由运营手工整理</p>\n    </div>\n\n    <ol class=\"timeline\" aria-label=\"直连节点演进时间线\">\n      <li class=\"step\">\n        <time>2022 / 03</time>\n        <h3>单节点试运行</h3>\n        <p>在两座城市之间架设首批转发节点,用于内部链路压测;同步建立基础流量计费与设备并发上限逻辑。</p>\n      </li>\n      <li class=\"step\">\n        <time>2022 / 08</time>\n        <h3>三区节点池</h3>\n        <p>扩容至三区节点池,接入普通线路与中转线路双通道;首次引入每月 100GB 流量档位。</p>\n      </li>\n      <li class=\"step\">\n        <time>2023 / 02</time>\n        <h3>原生流媒体解锁</h3>\n        <p>对节点 IP 进行定期轮换,接入原生流媒体解锁能力;同时上线“全节点解锁”档位的雏形。</p>\n      </li>\n      <li class=\"step\">\n        <time>2023 / 09</time>\n        <h3>IPLC 专线引入</h3>\n        <p>开通 IPLC 专线用于游戏与跨境会议场景,延迟敏感型流量从公网中分离出来,形成独立通道。</p>\n      </li>\n      <li class=\"step now\">\n        <time>2024 / 05 — 现在</time>\n        <h3>三档并行 · 设备并发</h3>\n        <p>正式落地基础版、旗舰版、团队版三档并行,设备并发上限分别设置为 3 / 5 / 20 台,并提供工单与客户经理两条支持通道。</p>\n      </li>\n    </ol>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <p class=\"kicker\">PRICING · 票据</p>\n    <h2>三档套餐,左右对照,中间是推荐位</h2>\n    <p class=\"sub\">下面的两张票据分别代表“基础版 / 旗舰版”与“旗舰版 / 团队版”。虚线边框取自票据样式,数字使用等宽字体,方便横向比对同档权益。</p>\n\n    <div class=\"plans\">\n      \n      <div class=\"col\">\n        <article class=\"ticket\">\n          <span class=\"tag\">基础版</span>\n          <p class=\"price\">¥15 / 月</p>\n          <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p>适合:轻度浏览、临时差旅、单设备长期挂着。</p>\n        </article>\n\n        <article class=\"ticket\">\n          <span class=\"tag acc\">旗舰版 · 推荐</span>\n          <span class=\"stamp\">RECOMMEND</span>\n          <p class=\"price\">¥35 / 月</p>\n          <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p>适合:多设备并行、家中常驻游戏与流媒体。</p>\n        </article>\n      </div>\n\n      \n      <div class=\"col\">\n        <article class=\"ticket\">\n          <span class=\"tag acc\">旗舰版 · 推荐</span>\n          <p class=\"price\">¥35 / 月</p>\n          <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p>参照左侧对照,可与基础版对比“流量 / 设备数 / 解锁范围”。</p>\n        </article>\n\n        <article class=\"ticket\">\n          <span class=\"tag\">团队版</span>\n          <p class=\"price\">¥85 / 月</p>\n          <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p>适合:小型工作室、多人合住、需要专属客户经理的对公场景。</p>\n        </article>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <p class=\"kicker\">HOW TO USE · 五步</p>\n    <h2>使用说明:从下单到上线,五步走完</h2>\n    <p class=\"sub\">下面是一个新手第一次使用直连的完整流程。编号沿用时间线的字体风格,方便把它当作一张说明单贴在桌前。</p>\n\n    <div class=\"how\">\n      <div class=\"row\">\n        <div class=\"num\">01</div>\n        <div>\n          <h3>选档</h3>\n          <p>从基础版、旗舰版、团队版中选一档;月付与年付均可,年付在票据底部以等宽字体单独标注。</p>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">02</div>\n        <div>\n          <h3>下单</h3>\n          <p>在下单页面填写账号与邮箱;支付完成后,套餐会以票据形式出现在账户中心,可随时回看。</p>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">03</div>\n        <div>\n          <h3>导入节点</h3>\n          <p>在订阅详情页复制订阅地址,粘贴到你常用的客户端即可;支持一键导入和手动导入两种方式。</p>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">04</div>\n        <div>\n          <h3>选择节点</h3>\n          <p>在客户端节点列表中按延迟排序;游戏玩家建议优先选择带“IPLC”标签的专线节点。</p>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"num\">05</div>\n        <div>\n          <h3>遇到问题就开工单</h3>\n          <p>基础版走普通工单,旗舰版走优先工单,团队版由专属客户经理直接对接;回复时间见各档说明。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"nodes\">\n  <div class=\"wrap\">\n    <p class=\"kicker\">NODES · 票据清单</p>\n    <h2>节点与设备兼容:一张票据清单</h2>\n    <p class=\"sub\">下面按区域与设备类型列出常见节点分组。票据上的虚线框表示信息随时可能更新,以客户端实际显示为准。</p>\n\n    <div class=\"nodes\">\n      <article class=\"ticket\">\n        <span class=\"tag\">REGION</span>\n        <h4>常用区域节点</h4>\n        <p>覆盖日常浏览、跨境办公、远程协作等场景;普通线路与中转线路并存,延迟与带宽表现差异较大。</p>\n      </article>\n      <article class=\"ticket\">\n        <span class=\"tag\">IPLC</span>\n        <h4>IPLC 专线节点</h4>\n        <p>面向游戏加速与视频会议;专线通道与公网隔离,适合对延迟敏感的实时业务。</p>\n      </article>\n      <article class=\"ticket\">\n        <span class=\"tag\">STREAM</span>\n        <h4>原生流媒体节点</h4>\n        <p>按区域分配原生 IP,支持常见海外流媒体平台的地区内容解锁;旗舰版及以上全节点可用。</p>\n      </article>\n      <article class=\"ticket\">\n        <span class=\"tag\">DEVICE</span>\n        <h4>桌面设备</h4>\n        <p>常见桌面系统均可通过订阅地址一键导入;建议在客户端开启“按延迟自动选择”。</p>\n      </article>\n      <article class=\"ticket\">\n        <span class=\"tag\">DEVICE</span>\n        <h4>移动设备</h4>\n        <p>手机与平板使用同一订阅地址即可;注意后台策略可能影响长连接,建议在客户端中开启保活。</p>\n      </article>\n      <article class=\"ticket\">\n        <span class=\"tag\">DEVICE</span>\n        <h4>路由器 / 旁路</h4>\n        <p>在支持订阅的路由器固件中粘贴订阅地址,即可对家中设备统一下发;并发数以套餐档位为准。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <p class=\"kicker\">FAQ · 对话气泡</p>\n    <h2>常见问答:左侧是用户,右侧是直连</h2>\n    <p class=\"sub\">下面这一组问答以对话气泡的形式呈现。先是用户提问,再是直连的清单式回答;点击问题本身可以折叠或展开。</p>\n\n    <div class=\"faq\">\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                我手上有两台电脑、一部手机、一台平板,该选哪一档?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                设备数 4 台,落在“旗舰版”5 台上限之内。给一个清单:\n                <ul>\n                  <li>日常浏览、视频为主:基础版 3 台不够,建议直接选旗舰版。</li>\n                  <li>偶尔游戏、对延迟敏感:优先用带 “IPLC” 标签的节点。</li>\n                  <li>多人共用同一账号:按并发设备上限挑档,不要靠“换设备登录”来绕。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                套餐里的“极速流量”到底是什么?用完会怎样?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                简单列一下:\n                <ul>\n                  <li>“极速流量”是当月可用的高优先级配额,基础版 100GB / 旗舰版 300GB / 团队版 1000GB。</li>\n                  <li>用完之后,默认进入限速状态,而不是立刻断网,具体限速阈值以客户端提示为准。</li>\n                  <li>下个账期 1 日 0 点重置;不会因为未用完而结转。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                “IPLC 专线”适合我玩某款对战游戏吗?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                如果你玩的游戏服务器在海外、对延迟敏感,可以试试;清单式说明:\n                <ul>\n                  <li>IPLC 专线把游戏流量从公网中分离出来,跨城段波动更小。</li>\n                  <li>仅在旗舰版及以上套餐中提供,基础版不可用。</li>\n                  <li>实际体验取决于你所在城市、游戏服务器所在地与家中的网络状况。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                年付和月付怎么选更划算?会不会有中途涨价?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                直接给你一个对比清单:\n                <ul>\n                  <li>基础版:月付 ¥15 × 12 = ¥180;年付 ¥150,相当于省下一个月的费用。</li>\n                  <li>旗舰版:月付 ¥35 × 12 = ¥420;年付 ¥350,差额更大,长期使用建议年付。</li>\n                  <li>团队版:月付 ¥85 × 12 = ¥1020;年付 ¥850,适合预算确定的小型团队。</li>\n                  <li>年付周期内若价格调整,已付款的订单按原订单价格执行,不会追差价补缴。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                工单一般多久能回复?团队版的“客户经理”是真的吗?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                列清楚:\n                <ul>\n                  <li>基础版:走普通工单通道,按提交顺序处理。</li>\n                  <li>旗舰版:7×24 优先工单,响应速度优于普通通道。</li>\n                  <li>团队版:在订单生效后会指定一位客户经理,负责工单与定制路由的对接。</li>\n                  <li>具体回复时长受工单量影响,以工单系统显示的“预计响应”为准。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <details>\n        <summary>\n          <div class=\"qa\">\n            <div class=\"ava\">U</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">用户</div>\n                如果我不续费了,已经导入到客户端的订阅地址会立刻失效吗?\n              </div>\n            </div>\n          </div>\n        </summary>\n        <div class=\"a\">\n          <div class=\"qa\">\n            <div class=\"ava\">直</div>\n            <div class=\"q\">\n              <div class=\"bubble\">\n                <div class=\"who\">直连</div>\n                不会立刻断网,而是按下面的顺序收口:\n                <ul>\n                  <li>到期后,套餐状态变为“已过期”,节点仍可能短暂可用,具体以上次刷新时间为准。</li>\n                  <li>进入下一个账期仍未续费,订阅地址被服务端停用,客户端无法再拉到可用节点。</li>\n                  <li>账户内的历史工单与流量记录会保留一段时间,留出缓冲以便补缴或导出。</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap\">\n    <div><span class=\"dot\"></span>直连 · 以时间线串起每一次线路扩容</div>\n    <div>本页配色:黑白灰 + 一处橙色强调</div>\n  </div>\n</footer>",
